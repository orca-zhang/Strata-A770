+        h_v % h_k || C != (int64_t) S * (2ll * h_k + h_v) || (n_tok != 4 && n_tok != 6) ||
+        strata::q_of(stream)->get_device().get_info<
+            sycl::ext::oneapi::experimental::info::device::architecture>() !=
+            sycl::ext::oneapi::experimental::architecture::intel_gpu_acm_g10) return false;
+    // ponytail: specialize only the measured HK16/HV48 layout; other geometries keep the generic kernel.
+    if (h_k == 16 && h_v == 48) {
+        if (n_tok == 4) gdn_state_replay_split_barrier<4, true>(state, qkv, h, C, gate, beta, h_k, h_v, n_layers, n_keep, stream);
+        else gdn_state_replay_split_barrier<6, true>(state, qkv, h, C, gate, beta, h_k, h_v, n_layers, n_keep, stream);
+    } else if (n_tok == 4) gdn_state_replay_split_barrier<4>(state, qkv, h, C, gate, beta, h_k, h_v, n_layers, n_keep, stream);
+    else gdn_state_replay_split_barrier<6>(state, qkv, h, C, gate, beta, h_k, h_v, n_layers, n_keep, stream);
+    return true;
+}
