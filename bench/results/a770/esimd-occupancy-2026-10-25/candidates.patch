+bool gdn_commit_layers_cols16_grf128(float* state, const float* qkv, const float* h,
+                            int C, const float* gate, const float* beta, int h_k, int h_v,
+                            int n_tok, int n_layers, const int32_t* n_keep, void* stream) {
+    // ponytail: batch the existing fixed-layout commit; no pointer tables or extra device copies.
+    if (!state || !qkv || !h || !gate || !beta || !n_keep || n_layers <= 0 || h_k <= 0 || h_v <= 0 ||
+        h_v % h_k || C != (int64_t) S * (2ll * h_k + h_v) || (n_tok != 4 && n_tok != 6) ||
+        strata::q_of(stream)->get_device().get_info<
+            sycl::ext::oneapi::experimental::info::device::architecture>() !=
+            sycl::ext::oneapi::experimental::architecture::intel_gpu_acm_g10) return false;
+    // ponytail: specialize only the measured HK16/HV48 layout; other geometries keep the generic kernel.
+    if (h_k == 16 && h_v == 48) {
+        if (n_tok == 4) gdn_state_replay_cols16_grf128<4, true>(state, qkv, h, C, gate, beta, h_k, h_v, n_layers, n_keep, stream);
+        else gdn_state_replay_cols16_grf128<6, true>(state, qkv, h, C, gate, beta, h_k, h_v, n_layers, n_keep, stream);
+    } else if (n_tok == 4) gdn_state_replay_layers_esimd<4>(state, qkv, h, C, gate, beta, h_k, h_v, n_layers, n_keep, stream);
+    else gdn_state_replay_layers_esimd<6>(state, qkv, h, C, gate, beta, h_k, h_v, n_layers, n_keep, stream);
+    return true;
+}
