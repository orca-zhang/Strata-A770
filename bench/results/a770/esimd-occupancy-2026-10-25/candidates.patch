+bool gdn_commit_layers_variant_esimd(int mode, float* state, const float* qkv, const float* h,
+                            int C, const float* gate, const float* beta, int h_k, int h_v,
+                            int n_tok, int n_layers, const int32_t* n_keep, void* stream) {
+    if (mode == 1) return gdn_commit_layers_cols16_grf128(state, qkv, h, C, gate, beta, h_k, h_v, n_tok, n_layers, n_keep, stream);
+    if (mode == 2) return gdn_commit_layers_cols16_grf256(state, qkv, h, C, gate, beta, h_k, h_v, n_tok, n_layers, n_keep, stream);
+    if (mode == 3) return gdn_commit_layers_state_prefetch4(state, qkv, h, C, gate, beta, h_k, h_v, n_tok, n_layers, n_keep, stream);
+    return false;
 }
 
