# Host engine and existing CPU expert implementation; GPU images come from the
# same numerical source library as the standalone native checks.
find_package(Threads REQUIRED)
set(STRATA_GGML_DIR "" CACHE PATH "llama.cpp checkout containing ggml")
if(NOT STRATA_GGML_DIR)
  include(FetchContent)
  FetchContent_Declare(strata_orca_llama
    GIT_REPOSITORY https://github.com/ggml-org/llama.cpp.git
    GIT_TAG 3cf03257f219afbe7334045ff7c6a06ac68c627d GIT_SHALLOW FALSE)
  FetchContent_GetProperties(strata_orca_llama)
  if(NOT strata_orca_llama_POPULATED)
    FetchContent_Populate(strata_orca_llama)
  endif()
  set(STRATA_GGML_DIR "${strata_orca_llama_SOURCE_DIR}")
endif()
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(GGML_STATIC ON CACHE BOOL "" FORCE)
foreach(_option CUDA SYCL OPENMP BACKEND_DL BUILD_TESTS BUILD_EXAMPLES)
  set(GGML_${_option} OFF CACHE BOOL "" FORCE)
endforeach()
set(GGML_NATIVE ON CACHE BOOL "" FORCE)
add_subdirectory("${STRATA_GGML_DIR}/ggml" "${CMAKE_CURRENT_BINARY_DIR}/ggml" EXCLUDE_FROM_ALL)

set(_cpu_sources expert pool expert_layout q2_avx2 native_expert iq_avx512 iq_avx2 kq_avx2)
set(_cpu_files "")
foreach(_name IN LISTS _cpu_sources)
  list(APPEND _cpu_files "${STRATA_ROOT}/src/kernels/cpu/${_name}.cpp")
endforeach()
add_library(strata_orca_cpu STATIC ${_cpu_files})
target_compile_features(strata_orca_cpu PUBLIC cxx_std_20)
target_include_directories(strata_orca_cpu PUBLIC ${_includes})
target_compile_definitions(strata_orca_cpu PUBLIC STRATA_NATIVE_EXPERTS=1)
target_compile_options(strata_orca_cpu PRIVATE ${_flags})
target_link_libraries(strata_orca_cpu PUBLIC ggml-cpu ggml-base Threads::Threads)
foreach(_name expert iq_avx512)
  set_source_files_properties("${STRATA_ROOT}/src/kernels/cpu/${_name}.cpp" PROPERTIES
    COMPILE_OPTIONS "-mavx512f;-mavx512bw;-mavx512vl;-mavx512dq;-mavx512vnni;-mavx512vbmi;-mf16c;-mfma")
endforeach()
foreach(_name q2_avx2 iq_avx2 kq_avx2)
  set_source_files_properties("${STRATA_ROOT}/src/kernels/cpu/${_name}.cpp" PROPERTIES COMPILE_OPTIONS "-mavx2;-mfma;-mf16c")
endforeach()

function(orca_host_sources output)
  set(_files "")
  foreach(_relative IN LISTS ARGN)
    if(EXISTS "${STRATA_ROOT}/sycl/src/${_relative}")
      set(_input "${STRATA_ROOT}/sycl/src/${_relative}")
    else()
      set(_input "${STRATA_ROOT}/src/${_relative}")
    endif()
    set(_output "${_generated}/engine/${_relative}")
    add_custom_command(OUTPUT "${_output}"
      COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/prepare.py" "${_input}" "${_output}" --engine
      DEPENDS "${_input}" prepare.py VERBATIM)
    list(APPEND _files "${_output}")
  endforeach()
  set(${output} "${_files}" PARENT_SCOPE)
endfunction()
